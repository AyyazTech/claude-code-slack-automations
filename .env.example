# Optional environment variables — only needed if you build custom Claude Code
# scripts that talk to Slack/GitHub directly. The 5 automations in this repo
# use Anthropic's official "Claude in Slack" app — no env vars needed.

# Slack Bot Token (only if you build a custom seeding bot for testing)
SLACK_BOT_TOKEN=xoxb-...

# GitHub repo Claude should target by default
GITHUB_REPO=AyyazTech/your-repo-name

# Anthropic API key (only for direct Claude API usage, NOT for Claude in Slack)
ANTHROPIC_API_KEY=sk-ant-...
